{
  "name": "@joseestevez/vue-elastic-ui",
  "version": "0.13.2",
  "description": "Vue 3 component library built on design tokens and composition",
  "type": "module",
  "license": "MIT",
  "author": "Jose Estevez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoseEstevez520/elastic-ui.git"
  },
  "homepage": "https://github.com/JoseEstevez520/elastic-ui#readme",
  "bugs": {
    "url": "https://github.com/JoseEstevez520/elastic-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "vue",
    "vue3",
    "components",
    "ui",
    "tailwindcss",
    "motion",
    "morph",
    "reka-ui"
  ],
  "files": [
    "dist",
    "USAGE.md",
    "DECISIONS.md",
    "NOTICE"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./sandbox-runtime.js": "./dist/sandbox-runtime.js"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "prestorybook": "npm run build:sandbox",
    "storybook": "storybook dev -p 6006",
    "build": "vite build && npm run build:sandbox && cp src/styles/tokens.css dist/tokens.css",
    "build:sandbox": "vite build -c vite.sandbox.config.ts",
    "prebuild-storybook": "npm run build:sandbox",
    "build-storybook": "storybook build",
    "typecheck": "vue-tsc -b",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "motion-v": "^2.4.0",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.48.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "markdown-it": "^14.3.2",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0",
    "torph": "^0.1.3"
  },
  "devDependencies": {
    "@storybook/vue3-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "motion-v": "^2.4.4",
    "simple-icons": "^16.32.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1",
    "vue": "^3.5.43",
    "vue-component-meta": "^3.3.11",
    "vue-tsc": "^3.3.11"
  }
}
