{
  "name": "elastic-ui-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The elastic-ui site: a landing and docs built with the library itself",
  "license": "MIT",
  "author": "Jose Estevez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoseEstevez520/elastic-ui.git",
    "directory": "site"
  },
  "homepage": "https://github.com/JoseEstevez520/elastic-ui#readme",
  "bugs": {
    "url": "https://github.com/JoseEstevez520/elastic-ui/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "docs",
    "storybook",
    "elastic-ui"
  ],
  "scripts": {
    "predev": "node scripts/generate-meta.mjs && npm run build:sandbox --prefix ../packages/elastic-ui",
    "dev": "vite",
    "prebuild": "node scripts/generate-meta.mjs && npm run build:sandbox --prefix ../packages/elastic-ui",
    "build": "vite build",
    "pretypecheck": "node scripts/generate-meta.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "check": "npm run build && node scripts/check-frames.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.48.0",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@storybook/vue3-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "playwright": "^1.56.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vue-component-meta": "^3.3.11",
    "vue-tsc": "^3.3.11"
  }
}
