{
  "name": "elastic-ui",
  "version": "0.0.1",
  "description": "Vue 3 component library built on design tokens and composition",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build": "vite build && cp src/styles/tokens.css dist/tokens.css",
    "build-storybook": "storybook build",
    "typecheck": "vue-tsc -b"
  },
  "peerDependencies": {
    "motion-v": "^2.4.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@lucide/vue": "^1.48.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0",
    "torph": "^0.1.3"
  },
  "devDependencies": {
    "@storybook/vue3-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "motion-v": "^2.4.4",
    "simple-icons": "^16.32.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  }
}
