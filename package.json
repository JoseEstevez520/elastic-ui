{
  "name": "elastic-ui-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Workspace for elastic-ui: the component library and its site",
  "license": "MIT",
  "author": "Jose Estevez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoseEstevez520/elastic-ui.git"
  },
  "homepage": "https://github.com/JoseEstevez520/elastic-ui#readme",
  "bugs": {
    "url": "https://github.com/JoseEstevez520/elastic-ui/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "components",
    "ui",
    "design-system",
    "monorepo",
    "tailwindcss"
  ],
  "workspaces": [
    "packages/*",
    "site"
  ],
  "scripts": {
    "storybook": "npm run storybook -w packages/elastic-ui",
    "build": "npm run build -w packages/elastic-ui",
    "build-storybook": "npm run build-storybook -w packages/elastic-ui",
    "typecheck": "npm run typecheck -w packages/elastic-ui && npm run typecheck -w site",
    "site": "npm run dev -w site",
    "site:build": "npm run build -w site",
    "site:check": "npm run check -w site"
  },
  "engines": {
    "node": ">=20"
  }
}
